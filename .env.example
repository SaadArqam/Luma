# Copy to .env (local) and set the same values in Vercel → Settings → Environment
# Variables. Never commit real values. Anything prefixed NEXT_PUBLIC_ is visible
# in the browser — only put publishable keys there.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. BYPASSES Row Level Security — server-side only, and used by
# exactly the paths in lib/supabase-admin.ts (notification crons, the orphan-row
# claim in /api/migrate, and the migration-banner counts). Must never be given a
# NEXT_PUBLIC_ prefix or logged.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Bank logos (logo.dev) ───────────────────────────────────────────────────
# Publishable token — browser-visible by design. Without it, accounts fall back
# to initial-letter avatars; nothing breaks.
NEXT_PUBLIC_LOGO_DEV_TOKEN=your-logo-dev-publishable-token

# ── Web push notifications ──────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the cron endpoints require, sent as `Authorization: Bearer …`.
# Also set as a GitHub Actions secret for .github/workflows/notification-reminders.yml
CRON_SECRET=a-long-random-string

# ── Daily tip generation (optional) ─────────────────────────────────────────
# Groq is preferred when present; Anthropic is the fallback. With neither set,
# the daily tip falls back to a locally computed sentence.
AI_PROVIDER=
AI_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
